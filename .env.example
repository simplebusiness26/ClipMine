# Leave DATABASE_URL empty to use the built-in JSON store for the MVP.
# Set it tomorrow to a PostgreSQL/Supabase connection string and restart.
DATABASE_URL=

# These relative paths work for local development. Docker Compose overrides
# them with persistent in-container paths automatically.
CLIPMINE_DATA_DIR=data
CLIPMINE_STATIC_DIR=apps/web/dist
CLIPMINE_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
CLIPMINE_MAX_UPLOAD_MB=1024
CLIPMINE_MAX_SOURCE_MINUTES=180
CLIPMINE_WORKER_CONCURRENCY=1

# Local, credential-free transcription. The model downloads on first use.
CLIPMINE_TRANSCRIPTION_PROVIDER=faster-whisper
CLIPMINE_WHISPER_MODEL=tiny
CLIPMINE_WHISPER_DEVICE=cpu
CLIPMINE_WHISPER_COMPUTE_TYPE=int8

# Render profile. 720x1280 keeps MVP rendering practical.
CLIPMINE_RENDER_WIDTH=720
CLIPMINE_RENDER_HEIGHT=1280
